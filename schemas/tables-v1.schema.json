{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "upstreamCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "byteOrder": {
      "const": "little-endian"
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "enum": [
              "finesine",
              "finecosine",
              "finetangent",
              "tantoangle"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10240
          },
          "wordType": {
            "enum": [
              "int32",
              "uint32"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "name",
          "count",
          "wordType",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "upstreamCommit",
    "sourceSha256",
    "byteOrder",
    "tables"
  ],
  "additionalProperties": false
}
